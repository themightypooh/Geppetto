
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin

# ...except the kernel's test runner. The rule above exists because s&box regenerates its own
# csproj files; this one is hand-written and has to be in the repo for `dotnet run` to work.
!Effigy.Tests/Effigy.Tests.csproj
!ShaderForge.Tests/ShaderForge.Tests.csproj
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Halo MCC mount work - unrelated to Marionette, and ships GPL-3.0 binaries.
# Kept on disk, kept out of the repo.
Editor/HaloMount/

# Shader Forge test output — regenerated by `dotnet run` in ShaderForge.Tests
ShaderForge.Tests/out/

# Stray kernel test output at the repo root. Effigy.Tests/out/ is deliberately
# TRACKED — its sample OBJs are the reference the suite is read against.
/out/

# Halo MCC extraction — same policy as Editor/HaloMount above. These are ripped game
# assets and a probe that links GPL-3.0 Reclaimer binaries. Kept on disk, kept out of the repo.
Tools/HaloProbe/
Assets/models/halo/
Assets/materials/halo/
kit_sheets/

# Imported map kits (rp_*) — hundreds of MB of third-party content, sourced not authored.
Assets/models/rp_block/
Assets/models/rp_city/
Assets/models/rp_kit/
Assets/models/rp_town/
Assets/materials/rp_kit/

# Tamagotchi teardown kit: the .blend and tools/tama_gen.py are the source, and the FBX are what
# the script exports from them - 48 MB of it, two files over 10 MB each. Same policy as the
# compiled *.*_c above: the thing you edit is tracked, the thing a tool produces is not.
# Regenerate with: blender --background --python tools/tama_gen.py
Assets/models/tamagotchi/*.fbx

# Blender's own backup copy.
*.blend1

# Python bytecode and the FBX unit probe's scratch output.
tools/__pycache__/
tools/_unit_test_*.fbx
