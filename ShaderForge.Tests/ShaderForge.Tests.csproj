<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Marionette.ShaderForge.Tests</RootNamespace>
    <AssemblyName>ShaderForge.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The generator is compiled from source, the same arrangement Effigy.Tests uses. Unlike Effigy
    there is no second copy of the kernel to keep in sync: Shader Forge is an editor-only tool, so
    its kernel lives in Editor/ShaderForge and is compiled straight from there. If anything in it
    ever picks up a Sandbox or Editor reference, this project stops compiling and says so - which
    is the whole point of keeping it engine-free.
  -->
  <ItemGroup>
    <Compile Include="../Editor/ShaderForge/**/*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
