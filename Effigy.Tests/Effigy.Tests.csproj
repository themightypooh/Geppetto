<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Effigy.Tests</RootNamespace>
    <AssemblyName>Effigy.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    The kernel is compiled from source rather than referenced as a library, on purpose: it is
    meant to be copied into an s&box or Godot project as loose .cs files, exactly the way
    Marionette ships. Building it the same way here keeps that honest - if the kernel ever picks
    up a dependency this project stops compiling.
  -->
  <ItemGroup>
    <Compile Include="../Effigy/**/*.cs" />
    <Compile Include="*.cs" />

    <!--
      One file out of Marionette, on the same terms as the kernel: RigTrackName is plain C# with
      no engine types in it, and it decides whether every .riganim already on disk still finds its
      bones. Compiling it here is what lets that be tested at all - the rest of Marionette needs
      Sandbox and cannot be.
    -->
    <Compile Include="../Code/RigControl/RigTrackName.cs" />
  </ItemGroup>

</Project>
