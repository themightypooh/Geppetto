<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:modeldoc30:version{8c2d7a91-9c42-4bf0-883a-5a3b1762d4f1} -->
{
	// fp_arms -- custom first-person arms, replacing the Citizen viewmodel arms.
	//
	// GENERATED by gen_fp_arms.py (kept outside the repo, same convention as
	// lightswitch_gen.py / mic_gen.py / moth_assets_gen.py -- their outputs are checked in,
	// the generator scripts aren't). Re-run that rather than editing here.
	//
	// One FBX carries both meshes (fp_arm_R, fp_arm_L) bound to one armature (fp_arms_rig),
	// so a single RenderMeshFile pulls in the mesh, the skin weights AND the skeleton --
	// nothing else in this project has a rigged model, so there's no local vmdl to copy that
	// part from, but a skinned RenderMeshFile bringing its own skeleton along is standard.
	//
	// TWO CORRECTIONS AGAINST THE ORIGINAL SPEC, found by inspecting the actual FBX rather
	// than trusting the brief it shipped with:
	//   - There is no "pose_relax" action. The baked poses are pose_open, pose_point,
	//     pose_press, pose_pinch, pose_grip_round, pose_grip_flat -- "open" is the resting
	//     one (it's the first NLA track and the only unmuted one in the source file).
	//   - There are only TWO material slots, not three: fp_skin and fp_arm_cut. No
	//     fp_arm_nail material exists in the exported file.
	//
	// ANIMATION SEQUENCES ARE NOT WIRED UP HERE. The FBX embeds all 6 poses as separate
	// takes (confirmed: fp_arms_rig|pose_open, |pose_point, |pose_press, |pose_pinch,
	// |pose_grip_round, |pose_grip_flat), but the modeldoc30 AnimationList/AnimFile KV3
	// schema for pulling named takes out of a multi-take FBX isn't something this project
	// has ever done -- every other .vmdl here is static geometry -- and I have no s&box
	// editor in this environment to verify the field names against. Writing that block
	// blind risks breaking the WHOLE model import, not just the animations, which is worse
	// than leaving it out.
	//
	// So: open this in the Model Editor and add the 6 sequences from the embedded takes
	// (Animations -> Add Sequence, pick each pose_* take). Name the resulting sequences
	// exactly "pose_open", "pose_point", "pose_press", "pose_pinch", "pose_grip_round",
	// "pose_grip_flat" -- FirstPersonArmsComponent looks them up by those names and warns
	// loudly (same pattern ViewArmsComponent uses) if any are missing, rather than silently
	// leaving the fingers in the flat bind pose.
	rootNode =
	{
		_class = "RootNode"
		children =
		[
			{
				_class = "MaterialGroupList"
				children =
				[
					{
						_class = "DefaultMaterialGroup"
						remaps =
						[
							{
								from = "fp_skin.vmat"
								to = "materials/first_person/fp_skin.vmat"
							},
							{
								from = "fp_arm_cut.vmat"
								to = "materials/first_person/fp_arm_cut.vmat"
							},
						]
						use_global_default = false
						global_default_material = ""
					},
				]
			},
			{
				_class = "RenderMeshList"
				children =
				[
					{
						_class = "RenderMeshFile"
						filename = "models/first_person/fp_arms.fbx"
						import_translation = [ 0.0, 0.0, 0.0 ]
						import_rotation = [ 0.0, 0.0, 0.0 ]
						// 1.0 -- the FBX already carries inches (1 Blender unit = 1 inch,
						// apply_unit_scale=True / global_scale=1.0 in the exporter).
						import_scale = 1.0
						align_origin_x_type = "None"
						align_origin_y_type = "None"
						align_origin_z_type = "None"
						parent_bone = ""
					},
				]
			},
			{
				_class = "AnimationList"
				children =
				[
					{
						_class = "AnimFile"
						name = "pose_open"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 0
						reverse = false
					},
					{
						_class = "AnimFile"
						name = "pose_point"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 1
						reverse = false
					},
					{
						_class = "AnimFile"
						name = "pose_press"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 2
						reverse = false
					},
					{
						_class = "AnimFile"
						name = "pose_pinch"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 3
						reverse = false
					},
					{
						_class = "AnimFile"
						name = "pose_grip_round"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 4
						reverse = false
					},
					{
						_class = "AnimFile"
						name = "pose_grip_flat"
						activity_name = ""
						activity_weight = 1
						weight_list_name = ""
						fade_in_time = 0.2
						fade_out_time = 0.2
						looping = false
						delta = false
						worldSpace = false
						hidden = false
						anim_markup_ordered = false
						disable_compression = false
						enable_scale = false
						source_filename = "models/first_person/fp_arms.fbx"
						start_frame = -1
						end_frame = -1
						framerate = -1.0
						take = 5
						reverse = false
					},
				]
				default_root_bone_name = ""
			},
			{
				// THE ACTUAL FIX for the missing upper_arm_R/L bones -- inspected fp_arms.fbx
				// directly in Blender (headless): the FBX is correct, all 27 bones exist with the
				// right parent chain (arm_root -> upper_arm_* -> forearm_* -> hand_* -> fingers).
				// The AnimationList above does NOT rescue them either -- confirmed live, still 24
				// bones with it -- because the 6 pose actions only keyframe the FINGER bones (they're
				// hand poses, not arm animations), so arm_root/upper_arm_R/upper_arm_L are neither
				// weighted by the mesh NOR animated by anything imported, and the compiler prunes
				// them as unused. do_not_discard is the actual escape hatch -- same mechanism the
				// Citizen first_person_arms_preview.vmdl uses for its own IK-only bones
				// (arm_upper_R, hand_R_to_weapon_ikrule, etc; see that file's BoneMarkupList).
				_class = "BoneMarkupList"
				children =
				[
					{
						_class = "BoneMarkup"
						target_bone = "arm_root"
						ignore_Translation = false
						ignore_rotation = false
						do_not_discard = true
					},
					{
						_class = "BoneMarkup"
						target_bone = "upper_arm_R"
						ignore_Translation = false
						ignore_rotation = false
						do_not_discard = true
					},
					{
						_class = "BoneMarkup"
						target_bone = "upper_arm_L"
						ignore_Translation = false
						ignore_rotation = false
						do_not_discard = true
					},
				]
				bone_cull_type = "None"
			},
		]
		model_archetype = ""
		primary_associated_entity = ""
		anim_graph_name = ""
		base_model_name = ""
	}
}
